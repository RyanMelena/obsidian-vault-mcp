# --- vault ---------------------------------------------------------------
VAULT_PATH=/vault
INBOX_DIR=ai-inbox
TMP_DIR=.ai-tmp

# --- http ----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=3940
MCP_PATH=/mcp
WEBHOOK_PATH=/hooks/gitea

# --- git -----------------------------------------------------------------
GIT_ENABLED=true
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_AUTHOR_NAME=obsidian-vault-mcp
GIT_AUTHOR_EMAIL=vault-mcp@internal.example.com
AUTO_PUSH=true

# Generate with: openssl rand -hex 32
# Must match the secret configured on the Gitea webhook.
GITEA_WEBHOOK_SECRET=

# Auth for the remote. Leave all three unset to use SSH (mount a deploy key at
# $HOME/.ssh instead). For HTTP(S), set a Gitea access token with the
# write:repository scope; any username works.
# GIT_REMOTE_URL=https://gitea.internal.example.com/you/vault.git
# GIT_USERNAME=you
# GIT_TOKEN=
# Or read the token from a file (Compose/Docker secret) instead:
# GIT_TOKEN_FILE=/run/secrets/gitea_token

# --- indexing ------------------------------------------------------------
# Optional. OHS's chokidar watcher normally picks up changes on its own; set
# this only if you want indexing to be synchronous with writes. {path} is
# replaced with the vault-relative path, or empty for a full reindex.
# REINDEX_CMD=obsidian-hybrid-search reindex {path}

LOG_LEVEL=INFO

# --- search backend ------------------------------------------------------
OHS_ENABLED=true
# true: this process spawns and supervises `obsidian-hybrid-search serve`.
# false: point OHS_URL at a serve process you run yourself.
OHS_SPAWN=true
OHS_URL=http://127.0.0.1:3939/mcp
OHS_COMMAND=obsidian-hybrid-search
OHS_PORT=3939
OHS_STARTUP_TIMEOUT=120

# Read by the spawned backend:
OBSIDIAN_IGNORE_PATTERNS=.obsidian/**,.ai-tmp/**,templates/**,*.canvas
OPENAI_BASE_URL=http://ollama.internal.example.com:11434/v1
OPENAI_EMBEDDING_MODEL=bge-m3-8k
